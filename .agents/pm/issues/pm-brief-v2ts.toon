tests[5]:
  - command: "NPM_CONFIG_USERCONFIG=/dev/null npm run release:check"
    path: .
    scope: project
    timeout_seconds: 1800
  - command: "bun install --no-save && bun run release:check"
    path: .
    scope: project
    timeout_seconds: 1800
  - command: "npm run accept:packed"
    path: scripts/accept-packed.ts
    scope: project
    timeout_seconds: 300
  - command: "gh api repos/unbraind/pm-brief/secret-scanning/alerts --paginate --jq 'if length == 0 then true else error(\"secret alerts present\") end' >/dev/null && if git log --all -p --format= | rg -q '/home/[^/ ]+|/Users/[^/ ]+|[A-Za-z]:\\\\Users\\\\'; then exit 1; fi"
    path: .git
    scope: project
    timeout_seconds: 120
  - command: ./node_modules/.bin/pm validate && ./node_modules/.bin/pm merge reconcile --dry-run && ./node_modules/.bin/pm duplicates --since 2026-08-21 && ./node_modules/.bin/pm health --strict-exit
    path: .agents/pm
    scope: project
    timeout_seconds: 120
    pm_context_mode: tracker
