{"hash_algorithm":"sha256","ts":"2026-10-13T12:07:53.603Z","author":"pi-agent","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.3:cloud","agent_model_source":"environment","agent_instance":"875186e6344dc94b136dd364","agent_provenance":{"model":{"value":"glm-5.3:cloud","source":"environment"},"effort":null,"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-brief-ccwo"},{"op":"add","path":"/metadata/title","value":"Adopt the pm SDK 2026.10.13 read_output contract on every pm-brief read command"},{"op":"add","path":"/metadata/description","value":"pm-cli 2026.10.13 ships pm-extension-read-output-controls: a read-only extension command can declare read_output on its CommandDefinition and the host then applies the universal projection, amount, token-budget and cursor-continuation controls to it. Declare read_output on all nine pm-brief read commands (pm-brief has no writer commands), honour the host controls by returning structured payloads when host read-output options are requested, and cover the contract with real temp trackers through the installed host."},{"op":"add","path":"/metadata/type","value":"Feature"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-10-13T12:07:53.603Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-10-13T12:07:53.603Z"},{"op":"add","path":"/metadata/author","value":"pi-agent"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"2f7cf978e7ff301f2ac7bd650373abfa5ca12ff1da7b3a6363e39928a2f93715","item_hash_version":3,"message":"","event_class":"substantive","record_hash_version":1,"record_hash":"144640e2a2ed06163da0560d93b73084b39a14e7f8fbd97358fefd1ee7b7d3a7"}
