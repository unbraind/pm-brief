{"hash_algorithm":"sha256","ts":"2026-10-13T12:08:03.273Z","author":"pi-agent","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.3:cloud","agent_model_source":"environment","agent_instance":"875186e6344dc94b136dd364","agent_provenance":{"model":{"value":"glm-5.3:cloud","source":"environment"},"effort":null,"role":null,"topic":null},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-10-13T12:08:03.273Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-10-13T12:08:03.273Z","author":"pi-agent","text":"Adoption design: (1) bump the dev pin, peer floor and manifest pm_min_version to 2026.10.13 so the repo builds and tests against the SDK that actually carries the contract; (2) declare read_output per command - row collections for the two list-shaped reads (brief next: next; brief stale: stale) and singleton row_keys for the document/summary reads (brief, brief prompt, brief momentum, brief since, brief diverge, brief duplicates, brief governance); (3) handlers return the structured payload instead of the pre-rendered document when host read-output controls are requested, so the host output engine owns projection/budget/continuation and the registered renderer stays on the pre-rendered document path."}]}],"before_hash":"e74d3e897db35f80730f622f4cf1c6b26d92f61612d2fa8145dffa13e91b38d0","after_hash":"54290efe6c2e7894746b4bc6062b0c3a1933ac95264b0c63a4d81d5135c0571b","item_hash_version":3,"event_class":"substantive","record_hash_version":1,"record_hash":"c0b7cea184e60c6de5545ba63097b4b84fe62f736cfb296b315ea225191813d1"}
