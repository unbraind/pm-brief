{"ts":"2026-08-22T18:44:47.348Z","author":"ox-alpha","author_source":"asserted","agent_harness":"pi","agent_model":"stealth/ox-alpha","agent_model_source":"environment","agent_instance":"ff4d7fe766eadd085b366014","agent_provenance":{"model":{"value":"stealth/ox-alpha","source":"environment"},"effort":null,"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-brief-javk"},{"op":"add","path":"/metadata/title","value":"Alert on daily release failure and require merge drivers in CI"},{"op":"add","path":"/metadata/description","value":"Two CI fixes: (1) release.yml gets an if:failure() job that opens or updates one deduplicated tracking issue (label release-failure, stable title) with job name, run URL, commit SHA and date; issues:write only, never blocks a release. (2) ci.yml installs pm merge drivers before the health gate and passes --require-merge-drivers so a fresh clone without clone-local driver config fails the gate instead of silently passing. Motivated by five unnoticed failed daily releases (2026-08-17..2026-08-22) caused by an expired npm token."},{"op":"add","path":"/metadata/type","value":"Chore"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":1},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-08-22T18:44:47.348Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-08-22T18:44:47.348Z"},{"op":"add","path":"/metadata/author","value":"ox-alpha"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"125580069aa156e3f603243608e31fdd87cc145b40386bf98cbe729a3e9be7ba","item_hash_version":2,"message":""}
